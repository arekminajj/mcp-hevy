{
  "name": "mcp-hevy",
  "version": "0.1.0",
  "description": "MCP server for the Hevy workout app API — lets AI agents fetch and analyze your workouts.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-hevy": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": ["mcp", "hevy", "workout", "fitness", "model-context-protocol"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
